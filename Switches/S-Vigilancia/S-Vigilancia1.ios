#

username CIT privilege 15 secret tc2006b
username CEO privilege 15 secret tc2006b

ip domain name chufani.com

login block-for 120 attempts 2 within 30

crypto key generate rsa
yes
1024

line console 0
    login local
    exec-timeout 3
    logging synchronous

line vty 0 1
    exec-timeout 3
    transport input ssh
    login local
    logging synchronous

!================ Fin de Configuración Global ==========================

!======================= Configuracion de VLANS =======================

vtp domain chufani.com
vtp mode client
vtp password tc2006b

! Puertos VLAN CCTV
interface range g1/0/1-6
  description Puerto de la VLAN CCTV
  switchport mode access
  switchport access vlan 80
  no shutdown

! Puertos VLAN Control de Acceso
interface range g1/0/7-8
  description Puerto de la VLAN Control de Acceso
  switchport mode access
  switchport access vlan 81
  no shutdown

! Puertos VLAN Oficinas
interface range g1/0/9-12
  description Puerto de la VLAN Oficinas
  switchport mode access
  switchport access vlan 40
  no shutdown

! Puertos VLAN Front Desk
interface range g1/0/13-20
  description Puerto de la VLAN Front Desk
  switchport mode access
  switchport access vlan 60
  no shutdown

! Puertos TRUNK
interface range g1/0/23-24
  description Puerto de la VLAN Gestion
  switchport mode TRUNK
  no shutdown

interface VLAN 911
  description Interfaz VLAN Gestion
  ip address 172.19.2.194 255.255.255.224
  no shutdown

ip default-gateway 172.19.2.222

!============== Fin de configuracion de VLANS en Switch ==============

!=============== Fin de la Configuracion del Switch ===================
