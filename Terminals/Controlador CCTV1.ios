#

username CIT privilege 15 secret tc2006b
username CEO privilege 15 secret tc2006b

ip domain name chufani.com

service password-encryption 

login block-for 120 attempts 2 within 30

crypto key generate rsa
yes
1024

line console 0
    login local
    exec-timeout 3
    logging synchronous

line vty 0 1
    exec-timeout 3
    transport input ssh
    login local
    logging synchronous

service password-encryption 

!================ Fin de Configuración Global ==========================

!======================= Configuracion de VLANS =======================

vtp domain chufani.com
vtp mode client
vtp password tc2006b

! Puertos TRUNK
interface range g1/0/23-24
  description Puerto de la VLAN Gestion
  switchport mode TRUNK
  no shutdown

interface VLAN 80
  description Interfaz VLAN CCTV
  ip address 172.19.3.21 255.255.255.248
  no shutdown

ip default-gateway 172.19.3.22

!============== Fin de configuracion de VLANS en Switch ==============

!=============== Fin de la Configuracion del Switch ===================

no interface VLAN 80

interface g1/0/23
  description Uplink-CCTV-Upstream
  no switchport
  ip address 172.19.3.21 255.255.255.248
  no shutdown