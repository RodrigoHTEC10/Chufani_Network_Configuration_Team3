#

! Base de datos de usuarios para autenticacion local con privilegios administrativos
username CIT privilege 15 secret tc2006b
username CEO privilege 15 secret tc2006b

! Configurar el nombre de dominio para la generacion de claves criptograficas de SSH
ip domain name chufani.com

! Configuracion de seguridad para bloquear intentos fallidos de acceso
login block-for 120 attempts 2 within 30

! Generar claves RSA para SSH
crypto key generate rsa
yes
1024

! Proteccion del acceso fisico por consola del switch
line console 0
    login local
    exec-timeout 3
    logging synchronous

! Configuracion de acceso remoto por VTY para las lineas 0 y 1
line vty 0 1
    exec-timeout 3
    transport input ssh
    login local
    logging synchronous

!================ Fin de Configuración Global ==========================

!================= Configuracion de Capa 2 =======================

! Configuracion del switch como servidor VTP
vtp domain chufani.com
vtp mode server 
vtp password tc2006b


! Crear la base de VLANs en el switch core
vlan 10
  name Servidores
  exit

vlan 20
  name Ventas
  exit

vlan 21
  name Presupuestos
  exit

vlan 30
  name Proyectos
  exit

vlan 40
  name Oficinas
  exit

vlan 50
  name Direccion
  exit

vlan 51
  name CEO
  exit

vlan 60
  name Front_Desk
  exit

vlan 61
  name Invitados
  exit

vlan 70
  name VozIP
  exit

vlan 71
  name Impresoras
  exit

vlan 80
  name CCTV
  exit

vlan 81
  name Control_de_Acceso
  exit

vlan 90
  name IoT
  exit

vlan 98
  name Firewall_Sophos
  exit

vlan 911
  name Gestion
  exit

! Configurar los puertos troncales del switch core hacia los switches de acceso
interface range g1/0/1-24
  description Puerto de la VLAN Gestion
  switchport mode TRUNK
  no shutdown

!================ Configuracion de Gestion ========================
! Configuracion de la interfaz VLAN 911 de gestion
interface VLAN 911
  description Interfaz VLAN Gestion
  ip address 172.19.2.193 255.255.255.224
  no shutdown

! Configurar la puerta de enlace
ip default-gateway 172.19.2.222


!=============== Fin de la Configuracion del Switch ===============
